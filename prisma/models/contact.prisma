enum ContactUsQuestion {
  GENERAL
  TECHNICAL
  BILLING
  OTHER
}

enum ContactUsStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model ContactUs {
  id           String            @id @default(cuid())
  question     ContactUsQuestion
  message      String
  contactEmail String
  status       ContactUsStatus   @default(OPEN)

  viewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt, id])
  @@index([status, createdAt, id])
  @@map("contact_us")
}
