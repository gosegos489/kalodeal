enum ListingCurrency {
  EUR
  USD
}

enum ListingStatus {
  PENDING
  CHANGES_REQUESTED
  ACTIVE
  HIDDEN
  REJECTED
  INACTIVE
  SOLD
}

enum ListingPricePeriod {
  DAY
  WEEK
  MONTH
  YEAR
}

model Listing {
  id              String              @id @default(cuid())
  title           String
  description     String
  price           Decimal?
  currency        ListingCurrency     @default(EUR)
  priceNegotiable Boolean             @default(false)
  // Null for one-off prices and legacy rentals whose period is still unknown.
  pricePeriod     ListingPricePeriod?
  phone           String
  phoneReveals    Int                 @default(0)
  youtube         String?
  facebookUrl     String?
  messengerUrl    String?

  // Nullable for existing listings; application writes require a catalogue pair.
  // The migration also enforces valid district/area pairs with a CHECK constraint.
  district String?
  area     String?

  status ListingStatus @default(PENDING)

  moderationReason  String?
  moderationMessage String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images ListingImage[]

  stats           ListingStats?
  propertyDetails PropertyDetails?
  vehicleDetails  VehicleDetails?
  favorites       Favorite[]
  views           ListingDailyView[]
  conversations   Conversation[]

  boostedAt DateTime? @map("bumpedAt")

  // Selection is independent of the monthly Boost allowance.
  featuredAt DateTime?

  sortDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, status, createdAt, id])
  @@index([status, featuredAt, id])
  @@index([categoryId])
  @@index([status, sortDate])
  @@index([status, categoryId, currency, price, id])
  @@index([status, district, sortDate, id])
  @@index([status, district, area, sortDate, id])
  @@map("listing")
}

// Only a per-listing, per-day hash of a random browser cookie is persisted.
model ListingDailyView {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  visitorHash String
  day         DateTime @db.Date

  @@unique([listingId, visitorHash, day])
  @@index([listingId, day])
  @@map("listing_daily_view")
}

model ListingStats {
  id String @id @default(cuid())

  listingId String  @unique
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  views         Int @default(0)
  contactClicks Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("listing_stats")
}

model Favorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId, createdAt, id])
  @@index([listingId])
  @@map("favorite")
}

model ListingImage {
  id String @id @default(cuid())

  key       String @unique
  sortOrder Int    @default(0)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([listingId])
  @@map("listing_image")
}
