enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum SubscriptionPaymentStatus {
  PAID
}

// An immutable receipt snapshot, written only after a verified Stripe invoice payment.
model SubscriptionPayment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      SubscriptionPaymentStatus @default(PAID)
  description String
  // Stripe minor units, e.g. 999 = EUR 9.99; never a decimal/float amount.
  amount      Int
  currency    String                    @db.VarChar(3)

  stripeInvoiceId      String @unique
  stripeSubscriptionId String

  paidAt    DateTime
  createdAt DateTime @default(now())

  @@index([userId, paidAt, id])
  @@map("subscription_payment")
}

model Subscription {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan   @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  bumpUsed Int @default(0)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  checkoutSessionId    String? @unique
  checkoutAttempt      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription")
}

model StripeWebhookEvent {
  id              String   @id
  type            String
  stripeCreatedAt DateTime
  processedAt     DateTime @default(now())

  @@map("stripe_webhook_event")
}
